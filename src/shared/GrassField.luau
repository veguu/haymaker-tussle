--!strict
--!native
-- GrassField - a map's very low grass tufts, built on THIS client from a layout and animated with one loop: a gentle
-- wind sway, and tufts bending away from characters passing through them, then easing back. Replaces GrassWind
-- (EditableMesh copies of merged chunks, per-vertex) and GrassClumps for maps that have a layout
-- (Config/GrassLayouts/<map>, generated by design/maps/gnomon_grass.py).
--
-- HOW, AND WHY IT'S CHEAP
-- * One template MeshPart per tuft shape (ReplicatedStorage.HT_GrassKit, all sharing one small atlas), cloned per
--   tuft: identical meshes and texture draw as GPU instances; Color carries the palette (the atlas is greyscale).
--   Never replicated (built locally, Archivable false, so an Edit preview never saves them), no shadows, no physics.
-- * Each tuft is modelled round its ROOT, so bending is one rotation about the root: the base stays planted and
--   the blades lean. One BulkMoveTo per frame for every tuft that moved.
-- * Only tufts within `WIND_FAR` of the camera sway (those past `TIER_NEAR` a quarter at a time per frame), and their sway fades to nothing between `WIND_NEAR` and
--   `WIND_FAR`, so a tuft leaving the range is already at rest: no pop, no snap. The near set is re-found from a
--   grid a few times a second, not every frame.
-- * Bending: characters (players and bots) are gathered a few times a second; each frame only the grid cells under
--   them are checked. A bent tuft eases toward its target quickly and back slowly (no snapping, no sudden rise),
--   capped at `BEND_MAX`, and is only remembered until it's upright again.
-- * Phones (touch, no keyboard) build every tuft but sway a smaller radius.
-- If the templates or the layout are missing, nothing is built and nothing errors.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Environment = require(script.Parent.Core.Environment)

local GrassField = {}

local CELL = 12 -- studs: the grid the near set and the bending look things up in
local WIND_NEAR = 45 -- full sway inside this distance from the camera
local WIND_FAR = 75 -- no sway past this (the fade ends here, so leaving the set is invisible)
local WIND_FAR_TOUCH = 55
local REFRESH = 0.25 -- seconds between re-finding the near set and the characters
local BEND_RADIUS = 3.2 -- studs round a character's root
local BEND_MAX = math.rad(38)
local BEND_HEIGHT = 5.5 -- a root more than this above a tuft's root doesn't bend it (jumping over it)
local BEND_IN = 16 -- easing rates (1/s): pushed over quickly
local BEND_OUT = 3.2 -- and back up slowly
local SWAY_LEAN = math.rad(2.5) -- the steady lean with the wind
local SWAY_GUST = math.rad(6) -- extra in a gust
local SWAY_FLUTTER = math.rad(2) -- the quick shiver
local BUILD_PER_FRAME = 350
local TIER_NEAR = 30 -- studs: tufts this close to the camera move every frame
local TIER_EVERY = 4 -- the rest take turns: each moves every 4th frame (slow sway, so this can't be seen)
local TAU = 2 * math.pi

export type Field = {
	step: (self: Field, t: number, camera: Vector3?) -> (),
	destroy: (self: Field) -> (),
	count: (self: Field) -> (number, number),
}

--- The layout module for a map id (Config/GrassLayouts, matched without case), or nil.
local function layoutFor(mapId: string?): any?
	if not mapId then
		return nil
	end
	local folder = script.Parent:FindFirstChild("Config")
	folder = folder and folder:FindFirstChild("GrassLayouts")
	if not folder then
		return nil
	end
	for _, child in folder:GetChildren() do
		if child:IsA("ModuleScript") and child.Name:lower() == mapId:lower() then
			local ok, layout = pcall(require, child)
			return if ok then layout else nil
		end
	end
	return nil
end

local function key(cx: number, cz: number): number
	return (cx + 2048) * 4096 + (cz + 2048)
end

--- The grass for `model` (the live map, pivoted on the arena centre at the floor's top), `mapId`'s layout, in
--- `wind` (a resolved preset's wind table). Returns nil when there is no layout or no kit.
function GrassField.new(model: Instance?, mapId: string?, wind: any): Field?
	if not model or not model:IsA("Model") then
		return nil
	end
	local layout = layoutFor(mapId)
	local kit = ReplicatedStorage:FindFirstChild("HT_GrassKit")
	if not layout or not kit then
		return nil
	end
	local templates: { MeshPart } = {}
	local offsets: { Vector3 } = {}
	local sizes: { Vector3 } = {}
	for i, t in layout.templates do
		local part = kit:FindFirstChild(t.name)
		if not part or not part:IsA("MeshPart") then
			return nil
		end
		templates[i] = part
		offsets[i] = t.offset
		sizes[i] = part.Size
	end

	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local windFar = if touch then WIND_FAR_TOUCH else WIND_FAR
	local windNear = math.min(WIND_NEAR, windFar * 0.6)
	local wx, wz = Environment.wind(wind.direction)
	local gustLength = math.max(wind.gustLength or 40, 1)
	local gustSeconds = math.max(wind.gustSeconds or 4.5, 0.1)
	local flutterSeconds = math.max(wind.flutterSeconds or 1.2, 0.1)

	local anchor = (model :: Model):GetPivot()
	local data = layout.data
	local stride = layout.stride
	local n = #data // stride

	-- per tuft (index i): the part, its root position (world), the root's turn and the offset to the part centre
	local parts: { MeshPart } = table.create(n)
	local rootPos: { Vector3 } = table.create(n)
	local toCentre: { CFrame } = table.create(n)
	local restRot: { CFrame } = table.create(n) -- turn * toCentre, kept so each move is one multiply less
	local phase: { number } = table.create(n)
	local px: { number } = table.create(n)
	local pz: { number } = table.create(n)
	local py: { number } = table.create(n)
	local grid: { [number]: { number } } = {}

	local folder = Instance.new("Folder")
	folder.Name = "HT_Grass"
	folder.Archivable = false
	folder.Parent = model

	local alive = true
	local built = 0

	-- built over a few frames, in small batches parented as a whole (see the header)
	task.spawn(function()
		local i = 0
		while alive and i < n do
			local batch = Instance.new("Folder")
			batch.Name = "Batch"
			batch.Archivable = false
			local last = math.min(n, i + BUILD_PER_FRAME)
			for k = i + 1, last do
				local b = (k - 1) * stride
				local x, y, z, rot, s =
					data[b + 1], data[b + 2], data[b + 3], data[b + 4], data[b + 5]
				local ti, ci = data[b + 6], data[b + 7]
				local root = anchor * CFrame.new(x, y, z)
				local r = anchor.Rotation * CFrame.Angles(0, rot, 0)
				local part = templates[ti]:Clone()
				part.Size = sizes[ti] * s
				part.Color = layout.colours[ci]
				part.Anchored = true
				part.CanCollide, part.CanQuery, part.CanTouch, part.CastShadow =
					false, false, false, false
				part.Archivable = false
				local centre = CFrame.new(offsets[ti] * s)
				part.CFrame = CFrame.new(root.Position) * r * centre
				part.Parent = batch
				parts[k] = part
				rootPos[k] = root.Position
				toCentre[k] = centre
				restRot[k] = r * centre
				phase[k] = ((x * 12.9898 + z * 78.233) % 1 + 1) % 1 * TAU
				px[k], py[k], pz[k] = root.Position.X, root.Position.Y, root.Position.Z
				local cell = key(math.floor(px[k] / CELL), math.floor(pz[k] / CELL))
				local list = grid[cell]
				if not list then
					list = {}
					grid[cell] = list
				end
				table.insert(list, k)
			end
			batch.Parent = folder
			built = last
			i = last
			task.wait()
		end
	end)

	-- the near set and the characters, refreshed every REFRESH seconds
	local near: { number } = {}
	local prevNear: { number } = {}
	local nearStamp: { number } = table.create(n, 0) -- = refreshNo while a tuft is in the near set
	local refreshNo = 0
	local roots: { Vector3 } = {}
	local nextRefresh = 0
	-- bending state, only for tufts that are (or are coming back from being) bent
	local bendX: { [number]: number } = {}
	local bendZ: { [number]: number } = {}
	local lastT: number? = nil
	local frameNo = 0

	local moveParts: { BasePart } = {}
	local moveFrames: { CFrame } = {}

	local function restFrame(i: number): CFrame
		return CFrame.new(rootPos[i]) * restRot[i]
	end

	local function refresh(camera: Vector3)
		-- tufts that drop out of the near set go back to rest (their sway had already faded to nothing)
		near, prevNear = prevNear, near
		table.clear(near)
		refreshNo += 1
		local camX, camZ = camera.X, camera.Z
		local c0x, c1x = math.floor((camX - windFar) / CELL), math.floor((camX + windFar) / CELL)
		local c0z, c1z = math.floor((camZ - windFar) / CELL), math.floor((camZ + windFar) / CELL)
		local far2 = windFar * windFar
		local count = 0
		for cx = c0x, c1x do
			-- skip whole cells outside the circle
			local ex = math.max(0, math.max(cx * CELL - camX, camX - (cx + 1) * CELL))
			for cz = c0z, c1z do
				local ez = math.max(0, math.max(cz * CELL - camZ, camZ - (cz + 1) * CELL))
				local list = if ex * ex + ez * ez < far2 then grid[key(cx, cz)] else nil
				if list then
					for _, i in list do
						local dx, dz = px[i] - camX, pz[i] - camZ
						if dx * dx + dz * dz < far2 then
							count += 1
							near[count] = i
							nearStamp[i] = refreshNo
						end
					end
				end
			end
		end
		for _, i in prevNear do
			if nearStamp[i] ~= refreshNo and not bendX[i] then
				table.insert(moveParts, parts[i])
				table.insert(moveFrames, restFrame(i))
			end
		end
		-- characters near the camera: every player's, and any other model with a root (the bots)
		table.clear(roots)
		local reach2 = (windFar + 20) ^ 2
		local function consider(root: Instance?)
			if root and root:IsA("BasePart") then
				local p = root.Position
				local dx, dz = p.X - camera.X, p.Z - camera.Z
				if dx * dx + dz * dz < reach2 then
					table.insert(roots, p)
				end
			end
		end
		for _, player in Players:GetPlayers() do
			local character = player.Character
			consider(character and character:FindFirstChild("HumanoidRootPart"))
		end
		for _, child in workspace:GetChildren() do
			if
				child:IsA("Model")
				and not Players:GetPlayerFromCharacter(child)
				and child:FindFirstChildOfClass("Humanoid")
			then
				consider(child:FindFirstChild("HumanoidRootPart"))
			end
		end
	end

	local self = {} :: any

	function self.step(_self: Field, t: number, camera: Vector3?)
		if not alive or built == 0 then
			return
		end
		local dt = if lastT then math.clamp(t - lastT, 0, 0.1) else 0
		lastT = t
		local cam = camera
			or (workspace.CurrentCamera and workspace.CurrentCamera.CFrame.Position)
			or Vector3.zero
		if t >= nextRefresh or t < nextRefresh - REFRESH * 2 then
			nextRefresh = t + REFRESH
			refresh(cam)
		end

		-- targets from characters: push away from each root, strongest at the centre
		local targetX: { [number]: number } = {}
		local targetZ: { [number]: number } = {}
		local r2 = BEND_RADIUS * BEND_RADIUS
		for _, p in roots do
			local c0x, c1x =
				math.floor((p.X - BEND_RADIUS) / CELL), math.floor((p.X + BEND_RADIUS) / CELL)
			local c0z, c1z =
				math.floor((p.Z - BEND_RADIUS) / CELL), math.floor((p.Z + BEND_RADIUS) / CELL)
			for cx = c0x, c1x do
				for cz = c0z, c1z do
					local list = grid[key(cx, cz)]
					if list then
						for _, i in list do
							local dx, dz = px[i] - p.X, pz[i] - p.Z
							local d2 = dx * dx + dz * dz
							local above = p.Y - py[i]
							if d2 < r2 and above > -1 and above < BEND_HEIGHT then
								local d = math.sqrt(d2)
								local f = 1 - d / BEND_RADIUS
								f = f * f * (3 - 2 * f)
								local a = BEND_MAX * f
								local ux, uz =
									if d > 1e-3 then dx / d else wx, if d > 1e-3 then dz / d else wz
								local ox, oz = targetX[i] or 0, targetZ[i] or 0
								local tx, tz = ux * a, uz * a
								if tx * tx + tz * tz > ox * ox + oz * oz then
									targetX[i], targetZ[i] = tx, tz
								end
							end
						end
					end
				end
			end
		end
		-- ease every bent or newly pushed tuft
		local kin, kout = 1 - math.exp(-BEND_IN * dt), 1 - math.exp(-BEND_OUT * dt)
		for i in targetX do
			if not bendX[i] then
				bendX[i], bendZ[i] = 0, 0
			end
		end
		for i, bx in bendX do
			local bz = bendZ[i]
			local tx, tz = targetX[i] or 0, targetZ[i] or 0
			local k = if tx * tx + tz * tz > bx * bx + bz * bz then kin else kout
			bx += (tx - bx) * k
			bz += (tz - bz) * k
			if tx == 0 and tz == 0 and bx * bx + bz * bz < 1e-6 then
				bendX[i], bendZ[i] = nil, nil
				if nearStamp[i] ~= refreshNo then
					table.insert(moveParts, parts[i])
					table.insert(moveFrames, restFrame(i))
				end
			else
				bendX[i], bendZ[i] = bx, bz
				if nearStamp[i] ~= refreshNo then -- bent but outside the sway range: still drawn here
					local ang = math.sqrt(bx * bx + bz * bz)
					local axis = Vector3.new(bz, 0, -bx) / ang
					table.insert(moveParts, parts[i])
					table.insert(
						moveFrames,
						CFrame.new(rootPos[i]) * CFrame.fromAxisAngle(axis, ang) * restRot[i]
					)
				end
			end
		end

		-- sway (and bend) for the near set
		local camX, camZ = cam.X, cam.Z
		local fadeSpan = windFar - windNear
		frameNo += 1
		local tierNear2 = TIER_NEAR * TIER_NEAR
		for _, i in near do
			local x, z = px[i], pz[i]
			local dx, dz = x - camX, z - camZ
			local d2 = dx * dx + dz * dz
			-- past TIER_NEAR, a tuft that isn't bent only moves on its turn
			if d2 > tierNear2 and not bendX[i] and (frameNo + i) % TIER_EVERY ~= 0 then
				continue
			end
			local dist = math.sqrt(d2)
			local amp = if dist <= windNear
				then 1
				else math.max(0, 1 - (dist - windNear) / fadeSpan)
			local along = x * wx + z * wz
			local across = -x * wz + z * wx
			local band = 0.5 + 0.5 * math.sin(TAU * (along / gustLength - t / gustSeconds))
			local lane = 0.65
				+ 0.35 * math.sin(TAU * (across / (gustLength * 2.3) + t / (gustSeconds * 3.1)))
			local gust = band * band * lane
			local shiver = math.sin(TAU * t / flutterSeconds + phase[i])
			local lean = amp * (SWAY_LEAN + SWAY_GUST * gust + SWAY_FLUTTER * shiver)
			local vx, vz = wx * lean, wz * lean
			local bx = bendX[i]
			if bx then
				vx += bx
				vz += bendZ[i]
			end
			local ang = math.sqrt(vx * vx + vz * vz)
			local frame
			if ang < 1e-4 then
				frame = restFrame(i)
			else
				if ang > BEND_MAX then
					vx, vz, ang = vx / ang * BEND_MAX, vz / ang * BEND_MAX, BEND_MAX
				end
				frame = CFrame.new(rootPos[i])
					* CFrame.fromAxisAngle(Vector3.new(vz, 0, -vx) / ang, ang)
					* restRot[i]
			end
			table.insert(moveParts, parts[i])
			table.insert(moveFrames, frame)
		end
		if #moveParts > 0 then
			workspace:BulkMoveTo(moveParts, moveFrames, Enum.BulkMoveMode.FireCFrameChanged)
			table.clear(moveParts)
			table.clear(moveFrames)
		end
	end

	function self.destroy(_self: Field)
		alive = false
		folder:Destroy()
		table.clear(parts)
		table.clear(grid)
	end

	function self.count(_self: Field): (number, number)
		return built, #near
	end

	return self :: Field
end

return GrassField
